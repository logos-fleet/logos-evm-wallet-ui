// QtRO view contract for the wallet UI. PROPs auto-sync to every QML replica;
// SLOTs are callable from QML (via logos.watch for the async reply). The C++
// backend (wallet_ui_backend.cpp) implements the SLOTs by calling
// wallet_backend_module over the type-safe modules() client.
class WalletUi
{
    // State (pushed to QML as it changes)
    PROP(QString statusText="Ready" READONLY)
    PROP(QString chainsJson READONLY)
    PROP(QString accountsJson READONLY)
    PROP(QString selectedAccount READWRITE)
    // The id of the signing request awaiting a human in the signer UI,
    // or "" when nothing is pending. There is no "unlocked" state any
    // more: the wallet never holds a vault password.
    PROP(QString pendingRequestId="" READONLY)
    PROP(QString balancesJson READONLY)
    PROP(QString tokensJson READONLY)
    PROP(QString historyJson READONLY)
    PROP(QString marketJson READONLY)
    PROP(QString proxyStatus="" READONLY)
    // THE ONE LEG OF A PRIVATE SEND THAT CAN REPORT PROGRESS, as one JSON
    // object: `{ "sync": { leg, state, percent, blocksRemaining, etaMs, … } }`.
    //
    // A private send is ~154 s on a phone and the accumulator sync is 92 % of
    // it (logos-workspace#235); the witness, the Groth16 proof and the verify
    // together are 3.7 s. `railgun_module` answers that sync in bounded windows
    // (`sync_step` / `sync_status` / `sync_cancel`), so this PROP is refreshed
    // between windows and a view has a real percentage and ETA rather than a
    // spinner. `state` is idle / running / done / cancelled / unavailable, and
    // the last of those carries the reason in `error`.
    PROP(QString privateSyncJson READONLY)
    // THE WHOLE OF A PRIVATE SEND, LEG BY LEG, as one JSON object:
    // `{ "send": { state, leg, legs: [{ name, state, note? }], … } }`.
    //
    // `privateSyncJson` above is ONE leg of this — the long one. This is the
    // send itself: `sync` (walk the accumulator up to the head), `prove`
    // (`relayed_send` builds the 7702 UserOp and its Groth16 proof and lodges
    // an approval request), `approve` (a human answers it in the Signer app)
    // and `broadcast` (the approved operation goes to the bundler through
    // eth_rpc). `leg` is the one running; `legs` is every leg with its own
    // state (pending / running / done / skipped / cancelled / failed), so a
    // view can show the whole route and not only the current step.
    //
    // WHY A SEND NEEDS THIS AT ALL: measured end to end, a RAILGUN private
    // send is ~154 s on a simulator and 239 s on a physical iPad, and a fixed
    // waiter under three minutes reports a failure for work that goes on to
    // succeed (logos-workspace#235). Nothing here is a guess — every state
    // change is a reply that landed.
    PROP(QString privateSendJson READONLY)
    // THE OTHER DIRECTION — PUBLIC FUNDS GOING IN, leg by leg, as one JSON
    // object: `{ "shield": { state, leg, legs: [{ name, state, hashes? }], … } }`.
    //
    // `privateSendJson` above spends a balance that is ALREADY shielded.
    // This is how a balance gets there: `plan` (ask `railgun_module` for the
    // shield calldata and read the account's nonce and the chain's gas price),
    // `sign` (one approval request in front of a human in the Signer app,
    // carrying every transaction of the route under a single key derivation),
    // then `wrap` (WETH9 `deposit()` — only when the caller asked to mint the
    // asset out of native ETH), `approve` (the ERC-20 allowance the shield
    // spends) and `shield` (the RailgunSmartWallet call itself). Each of the
    // last three is reported `running` when its signed transaction has been
    // broadcast and `done` when its receipt is mined, so the wait a user sees
    // is the chain's and is named.
    //
    // WHY IT IS A SECOND PROP AND NOT MORE LEGS ON THE ONE ABOVE: a shield and
    // a private send are separate operations a user starts separately, and a
    // route that showed six legs of which three were permanently `skipped`
    // would be describing a thing this wallet never does in one go.
    PROP(QString privateShieldJson READONLY)

    // Config / privacy
    SLOT(bool setProxyConfig(QString proxyJson))
    SLOT(bool setChains(QString chainsJson))
    SLOT(QString testEndpoint(int chainId))

    // Accounts (signing stays in the keystore module)
    // `createAccount` mints an UNRELATED account: a key no recovery phrase
    // covers. It is the only kind this wallet can make, because it holds no
    // seed — `keystore_module.create_unrelated_account`, which is Tier D and
    // therefore needs this module named a custodian first.
    //
    // `label` is ACCEPTED AND DROPPED by both variants. It used to reach
    // `labels.json` through `wallet_backend_module.create_account`, which no
    // longer exists; nothing has taken over storing it, so the New-account
    // dialog's Label field is inert until something does.
    SLOT(QString createAccount(QString passphrase, QString label))
    SLOT(QString importMnemonic(QString phraseJson, QString label))
    SLOT(void refreshAccounts())
    // Poll a signing request the wallet raised. Approval happens in the
    // signer UI, which is the only surface that takes the password.
    SLOT(QString sendStatus(QString requestId))

    // Balances + tokens
    SLOT(void refreshBalances(QString address))
    SLOT(void loadTokens(int chainId))
    SLOT(bool addCustomToken(QString tokenJson))

    // Market (Uniswap prices for held tokens)
    SLOT(void refreshMarket(QString address))

    // Send
    SLOT(QString estimateFee(QString sendJson))
    SLOT(QString sendNative(QString sendJson))
    SLOT(QString sendErc20(QString sendJson))

    // History
    SLOT(void refreshHistory(QString address))

    // Private (RAILGUN) — the accumulator sync a private send waits on.
    //
    // `refreshPrivateSync` costs ONE `eth_blockNumber` and walks nothing, so it
    // is what a wallet asks before it offers a private send: "this device is N
    // blocks behind" is the difference between a send that is instant and one
    // that is four minutes. `startPrivateSync` then walks it in windows,
    // publishing `privateSyncJson` after each.
    //
    // `cancelPrivateSync` IS NOT AN UNDO, and there is nothing to undo: every
    // window that completed is persisted, and a shield that is already mined is
    // on chain and owned by the wallet's 0zk address. Cancelling after a shield
    // leaves a shielded balance and no transfer — a state the wallet can show
    // and spend from. The post-cancel `privateSyncJson` says so in `note`.
    SLOT(void refreshPrivateSync())
    SLOT(QString startPrivateSync())
    SLOT(QString cancelPrivateSync())

    // A PRIVATE SEND, RUN AS ITS LEGS. `sendJson` is
    // `{to, asset, amount, memo?, owner, bundlerUrl}` — `to` is a `0zk…`
    // (private transfer) or a `0x…` (unshield), `owner` is the EOA that signs
    // the relayed operation and pays nothing, and `bundlerUrl` is the ERC-4337
    // bundler the operation is submitted to. Progress lands in
    // `privateSendJson`; the sync leg's own percentage stays in
    // `privateSyncJson`, which is the same walk seen from the same place.
    //
    // THE SEND STARTS THE WALK, and nothing else does — #235's fourth question
    // answered where it can be answered honestly. A wallet reads the DISTANCE
    // automatically (one `eth_blockNumber`), because that is one RPC and is
    // what lets it warn before a send is offered; WALKING is minutes of a
    // phone's radio, so it happens when something needs the tree, which is a
    // send. A send that finds the tree already at the head skips the leg and
    // says so.
    SLOT(QString startPrivateSend(QString sendJson))
    // GIVE UP ON THE SEND IN FLIGHT, and what that means depends on the leg —
    // which is why the answer is on the surface rather than in a tooltip.
    // During `sync` nothing was sent at all and every walked window is kept.
    // During `prove` and `approve` nothing has been signed or broadcast, and
    // the approval request is withdrawn from the Signer's queue. Once
    // `broadcast` has happened there is nothing to cancel — the operation is
    // the chain's — and this REFUSES rather than pretending otherwise.
    SLOT(QString cancelPrivateSend())

    // PUT PUBLIC FUNDS INTO THE POOL. `shieldJson` is
    // `{chainId, owner, asset, amount, wrap?}` — `owner` is the EOA that signs
    // and pays the gas, `asset` is the ERC-20 being shielded, `amount` is in
    // the asset's own base units, and `wrap: true` asks for a WETH9
    // `deposit()` on `asset` first, which is how native ETH becomes the ERC-20
    // RAILGUN can take. Progress lands in `privateShieldJson`.
    //
    // ONE HUMAN APPROVAL FOR THE WHOLE ROUTE. `keystore_module` signs a bundle
    // of legs under a single key derivation, so the wrap, the allowance and
    // the shield are shown together and answered once — and they are signed
    // with consecutive nonces, so the chain executes them in that order
    // without this wallet waiting for a receipt between them.
    SLOT(QString startPrivateShield(QString shieldJson))
    // GIVE UP, and what that costs depends on how far the route got. Before
    // the signatures are collected there is nothing on chain and the approval
    // request is withdrawn from the Signer's queue. Once ANY transaction has
    // been broadcast this REFUSES: the transactions are the chain's, they are
    // nonce-ordered and they will be mined.
    SLOT(QString cancelPrivateShield())
}
